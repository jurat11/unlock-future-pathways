# UNLOCK Coming Soon Deployment Configuration
# This configuration shows the coming soon page for all routes
# except the application form

RewriteEngine On

# Force HTTPS (if needed for production)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Handle the apply route - serve the React app
RewriteCond %{REQUEST_URI} ^/apply/?.*$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# Handle static assets (CSS, JS, images, etc.)
RewriteCond %{REQUEST_URI} \.(css|js|png|jpg|jpeg|gif|svg|ico|pdf|woff|woff2|ttf|eot)$ [NC]
RewriteRule . - [L]

# Handle comingsoonunlock assets
RewriteCond %{REQUEST_URI} ^/comingsoonunlock/
RewriteRule . - [L]

# Redirect all other routes to coming soon page
RewriteCond %{REQUEST_URI} !^/$
RewriteCond %{REQUEST_URI} !^/comingsoonunlock/
RewriteCond %{REQUEST_URI} !^/apply
RewriteCond %{REQUEST_URI} !\.(css|js|png|jpg|jpeg|gif|svg|ico|pdf|woff|woff2|ttf|eot)$ [NC]
RewriteRule ^(.*)$ / [L,R=302]

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType font/woff "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 month"
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>